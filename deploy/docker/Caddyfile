# 单镜像网关（Caddy）。容器里唯一对外的端口：18300，监听 0.0.0.0（容器网络内），宿主侧只发布到 127.0.0.1。
# 路由与 deploy/local/Caddyfile 一致；差别：监听地址、静态根目录、日志走标准输出、增加 /healthz 与 /healthz/<模块>。
{
	admin 127.0.0.1:2019
	auto_https off
	persist_config off
}

:18300 {
	# 网关自身与各服务的存活探针（只回 {"ok":true}，不带任何内部信息）
	handle /healthz {
		header Content-Type application/json
		respond `{"ok":true}` 200
	}
	handle /healthz/acct {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18301
	}
	handle /healthz/ride {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18302
	}
	handle /healthz/opgw {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18303
	}
	handle /healthz/onboard {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18304
	}
	handle /healthz/fleet {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18305
	}
	handle /healthz/site {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18306
	}
	handle /healthz/rule {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18307
	}
	handle /healthz/bill {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18308
	}
	handle /healthz/pay {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18309
	}
	handle /healthz/deposit {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18310
	}
	handle /healthz/settle {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18311
	}
	handle /healthz/cs {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18312
	}
	handle /healthz/ops {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18313
	}
	handle /healthz/enforce {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18314
	}
	handle /healthz/iam {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:18315
	}

	# 模块间接口一律不对外（含 /api/<模块>/internal 这类误挂的路径）
	@internal path /internal /internal/* /api/*/internal /api/*/internal/*
	handle @internal {
		header Content-Type application/json
		respond `{"code":"FORBIDDEN","message":"内部接口不对外开放"}` 403
	}

	# 公网入口：运营商只到 opgw，桩设备只到 site，联调环境只到 onboard
	handle /open/v1/* {
		reverse_proxy 127.0.0.1:18303
	}
	handle /device/v1/* {
		reverse_proxy 127.0.0.1:18306
	}
	handle /sandbox/* {
		reverse_proxy 127.0.0.1:18304
	}

	# 页面用接口 /api/<模块>/*
	handle /api/acct/* {
		reverse_proxy 127.0.0.1:18301
	}
	handle /api/ride/* {
		reverse_proxy 127.0.0.1:18302
	}
	handle /api/opgw/* {
		reverse_proxy 127.0.0.1:18303
	}
	handle /api/onboard/* {
		reverse_proxy 127.0.0.1:18304
	}
	handle /api/fleet/* {
		reverse_proxy 127.0.0.1:18305
	}
	handle /api/site/* {
		reverse_proxy 127.0.0.1:18306
	}
	handle /api/rule/* {
		reverse_proxy 127.0.0.1:18307
	}
	handle /api/bill/* {
		reverse_proxy 127.0.0.1:18308
	}
	handle /api/pay/* {
		reverse_proxy 127.0.0.1:18309
	}
	handle /api/deposit/* {
		reverse_proxy 127.0.0.1:18310
	}
	handle /api/settle/* {
		reverse_proxy 127.0.0.1:18311
	}
	handle /api/cs/* {
		reverse_proxy 127.0.0.1:18312
	}
	handle /api/ops/* {
		reverse_proxy 127.0.0.1:18313
	}
	handle /api/enforce/* {
		reverse_proxy 127.0.0.1:18314
	}
	handle /api/iam/* {
		reverse_proxy 127.0.0.1:18315
	}
	handle /api/* {
		header Content-Type application/json
		respond `{"code":"NOT_FOUND","message":"没有这个模块"}` 404
	}

	# 三个端的静态文件；原型里的说明文档与脚本不对外
	handle {
		@hidden path *.md *.sh /deploy/* /shared/_自测/*
		respond @hidden 404
		root * /srv/web
		file_server
	}

	# 后端实例不可达时给统一的错误体，不暴露内部信息
	handle_errors 502 503 504 {
		header Content-Type application/json
		respond `{"code":"SERVER_BUSY","message":"服务暂时不可用，请稍后再试"}` 503
	}

	log {
		output stdout
		format console
	}
}
