# 本机开发用的第三方二进制版本与本机端口。改版本后删掉 deploy/local/bin/ 下对应目录再跑 up.sh。
PG_VERSION=16.16
NATS_VERSION=2.15.3
CADDY_VERSION=2.11.9

# 15432 在本机已被 WSL（镜像网络模式）里的 PostgreSQL 占用，改用 15532；可用环境变量 BIKE_PG_PORT 覆盖
PG_PORT=${BIKE_PG_PORT:-15532}
NATS_PORT=14222
NATS_MONITOR_PORT=18222
GATEWAY_PORT=18300
CADDY_ADMIN_PORT=12019

# 一律只监听本机回环地址（backend/技术约定.md "只监听本机回环地址"）
LOCAL_HOST=127.0.0.1
