# /etc/bike/<实例名>.env 模板（一个实例一份，权限 0600，属主 bike）。<...> 为占位，由部署人员按城市填写。
# 变量名照 contracts/wire.md 第 5 节；调用关系照 deploy/services.tsv（生成方法同 deploy/local/gen-env.sh，地址换成生产地址）。
BIKE_MODULE=<模块>
PORT=<端口，见 backend/README.md>
LISTEN_HOST=0.0.0.0
DB_DSN=postgres://bike_<模块>:<口令>@<数据库主库地址>:5432/bike_<模块>?sslmode=require
NATS_URL=nats://<nats 地址 1>:4222,nats://<nats 地址 2>:4222,nats://<nats 地址 3>:4222
USER_JWT_PUBKEYS=<kid>=<公钥 base64>[,<轮换中的旧 kid>=<旧公钥>]
ADMIN_JWT_PUBKEYS=<kid>=<公钥 base64>[,<旧 kid>=<旧公钥>]
# 只有 acct：
# USER_JWT_PRIVKEY=<私钥种子 base64>
# USER_JWT_KID=<kid>
# 只有 iam：
# ADMIN_JWT_PRIVKEY=<私钥种子 base64>
# ADMIN_JWT_KID=<kid>
SERVICE_KEY=<本服务凭证，32 字节随机数十六进制>
# 无调用方时留空（systemd 环境文件不支持行尾注释，注释只能单独成行）
ALLOWED_CALLERS=<调用方>=<调用方凭证>[,...]
# 要调用的服务，有几个写几个；多实例的被调方写网关内网地址或本机反向代理地址
# <被调方大写>_URL=http://<地址>:<端口>
# 本服务专有的城市差异变量追加在 deploy/cities/<城市>/services/<模块>.env，部署时合并进本文件
