# /etc/bike/backup.env 模板（0600，属主 bike-backup）
BACKUP_DBS="bike_ride bike_bill bike_pay bike_deposit bike_settle bike_opgw bike_acct bike_cs bike_iam bike_rule bike_fleet bike_site bike_onboard bike_ops bike_enforce"
# rclone 远端名在 /etc/bike/rclone.conf 里配置（S3 兼容的异地对象存储，凭据只在那里）
BACKUP_REMOTE=bike-offsite:<桶>/<城市>
BACKUP_AGE_RECIPIENT=<运维 age 公钥>
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=bike_backup
PGPASSFILE=/etc/bike/backup.pgpass
RCLONE_CONFIG=/etc/bike/rclone.conf
